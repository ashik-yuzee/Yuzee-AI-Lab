{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "tsc --noEmit && vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs --external:vite",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:ux": "node --import ./node_modules/tsx/dist/loader.mjs tests/experience.test.ts && node --import ./node_modules/tsx/dist/loader.mjs tests/local-persistence.test.ts",
    "test:details": "node --import ./node_modules/tsx/dist/loader.mjs tests/detail-research.test.ts",
    "test:output": "node --import ./node_modules/tsx/dist/loader.mjs tests/output-review.test.ts",
    "test:oala": "node --import ./node_modules/tsx/dist/loader.mjs tests/oala.test.ts",
    "test:routing": "node --import ./node_modules/tsx/dist/loader.mjs tests/minilm-routing.test.ts",
    "eval:routing": "node --import ./node_modules/tsx/dist/loader.mjs tests/minilm-evaluation.ts",
    "test:routing-tokens": "node --import ./node_modules/tsx/dist/loader.mjs tests/minilm-token-budget.test.ts",
    "test:learning-depth": "node --import ./node_modules/tsx/dist/loader.mjs tests/learning-depth.test.ts && node --import ./node_modules/tsx/dist/loader.mjs tests/teaching-review.test.ts",
    "test:tool-reviews": "node --import ./node_modules/tsx/dist/loader.mjs tests/individual-tool-review.test.ts",
    "test:counselling": "node --import ./node_modules/tsx/dist/loader.mjs tests/counselling-style.test.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@huggingface/transformers": "^4.2.0",
    "ajv": "^8.20.0",
    "dotenv": "^17.2.3",
    "esbuild": "^0.25.0",
    "express": "^4.21.2",
    "franc-min": "^6.2.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.23.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
