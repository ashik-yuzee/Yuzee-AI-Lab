# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="your-gemini-api-key-here"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL: Optional. PostgreSQL connection string for conversation logging.
# When set, each chat turn is logged with token usage, cost, and truncated I/O text.
# conversation_logs rows are never deleted. App works without this set.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# ADMIN_USERNAME / ADMIN_PASSWORD: Credentials for the Token Lab admin login.
# Defaults to yuzeeadmin / yuzeeadmin@2026 if not set. Override in production.
ADMIN_USERNAME="yuzeeadmin"
ADMIN_PASSWORD="your-password-here"
# AUTH_SECRET: signs the login token. Set a long random value in every deployment (the built-in default is public).
AUTH_SECRET="change-me-to-a-long-random-string"

# CLOUDFLARE_ACCOUNT_ID / CLOUDFLARE_API_TOKEN: Optional. Used when "Llama 3.1-8b Fast" is
# selected as the mini routing model in the Navbar. Leave blank to disable that option.
CLOUDFLARE_ACCOUNT_ID="your-account-id-here"
CLOUDFLARE_API_TOKEN="your-api-token-here"

# EXP-RAG (optional). Warehouse SQLite used by the typed lookup and `npm run rag:index`.
# YUZEE_WAREHOUSE_DB="/path/to/training_gov.db"
# Semantic index location (default data/rag/warehouse-index.sqlite).
# YUZEE_RAG_INDEX="data/rag/warehouse-index.sqlite"
# Set to "off" to force lexical-only retrieval when the BGE model files are not deployed.
# EXP_RAG_DENSE="on"
# EXP-RAG embedding provider when the client picks "Server default". Default: gemini when GEMINI_API_KEY is set, else bge (local files).
# EXP_RAG_EMBEDDER="gemini"
# EXP_RAG_GEMINI_EMBED_MODEL="gemini-embedding-2"

# Warehouse intelligence (optional; docker-compose.intelligence.yml). Without these chat is unchanged.
# NEO4J_PASSWORD=""
# NEO4J_URI="bolt://localhost:7687"
# NEO4J_USER="neo4j"
# Server-wide kill switches (users can also switch each off in Settings → Data intelligence).
# INTELLIGENCE_GRAPH="off"
# INTELLIGENCE_FORECASTS="off"

# Whole-request ceiling for a chat turn (ms). Keep below the host limit (vercel.json maxDuration 300 s).
# RESPONSE_TIMEOUT_MS="90000"
# Writable runtime state (fallback conversation store, stats, logs). Defaults to ./data, or the temp dir on Vercel.
# YUZEE_STATE_DIR=""
