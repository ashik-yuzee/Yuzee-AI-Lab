# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="your-gemini-api-key-here"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL: Optional. PostgreSQL connection string for conversation logging.
# When set, each chat turn is logged with token usage, cost, and truncated I/O text.
# conversation_logs rows are never deleted. App works without this set.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# ADMIN_USERNAME / ADMIN_PASSWORD: Credentials for the Token Lab admin login.
# Defaults to yuzeeadmin / yuzeeadmin@2026 if not set. Override in production.
ADMIN_USERNAME="yuzeeadmin"
ADMIN_PASSWORD="yuzeeadmin@2026"